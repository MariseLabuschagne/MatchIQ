{
  "name": "matchiq",
  "private": true,
  "version": "4.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run src tests/report.test.ts",
    "test:watch": "vitest",
    "test:rules": "npx --no-install firebase emulators:exec --only firestore --project demo-matchiq \"vitest run tests/rules\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy": "npm run build && firebase deploy --only hosting,firestore",
    "version:small": "npm version minor --no-git-tag-version",
    "version:big": "npm version major --no-git-tag-version",
    "emulators": "firebase emulators:start --only auth,firestore --project matchiq-9f263",
    "seed:emulators": "node tests/seed-emulator.mjs",
    "dev:emulators": "VITE_USE_EMULATORS=true vite --port 5176"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "firebase": "^12.6.0",
    "jspdf": "^3.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.4",
    "firebase-tools": "^15.37.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^4.0.8"
  }
}
