rules_version = '2';
// MatchIQ Firestore security rules.
// Each signed-in user can read and write only their own profile and matches.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // A user may create their own profile, but may not give themselves a role other than parent.
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.role == 'parent';
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;

      // Legacy matches (v2 app) and new matches (v3 app).
      match /matches/{matchId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /matchesV3/{matchId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
